  "authoringPrompts": [
    {
      "id": "prompt-b4075c01-20d3-44ec-9ba6-429c9a73462e",
      "text": "I want to build the most striking example for ografstudio.org, with a Formula 1 theme. TracingInsights has the telemetry of past races: maybe we can build an example of one or two minutes on a real, clean finish, with all the timings, graphics and telemetry visuals."
    }
