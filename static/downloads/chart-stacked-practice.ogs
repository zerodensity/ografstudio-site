HEADER+`  vec2 cell = abs(fract(p / 0.34 + 0.5) - 0.5) * 0.34;\n  float grid = 1.0 - smoothstep(aa, aa * 2.0, min(cell.x, cell.y));\n  float signal = pow(0.5 + 0.5 * sin(p.x * 1.2 - t * 0.32), 8.0);\n  float horizon = exp(-abs(uv.y - 0.22) * 14.0);\n  float motif = grid * (0.25 + signal * 0.45) + horizon * signal * 0.45;`+FOOTER},sports:{name:\"Sports / Velocity diagonals\",source:HEADER+`  float diagonal = p.x * 0.68 + p.y;\n  float lane = abs(fract(diagonal / 0.38 + 0.5) - 0.5) * 0.38;\n  float stripes = 1.0 - smoothstep(0.025, 0.025 + aa, lane);\n  float energy = 0.5 + 0.5 * sin(diagonal * 2.1 - t * 0.58);\n  float motif = stripes * (0.25 + energy * 0.55) + energy * 0.12;`+FOOTER},entertainment:{name:\"Entertainment / Studio ribbons\",source:HEADER+`  float wave = sin(p.x * 0.9 - t * 0.18) * 0.18;\n  float ribbonDistance = (uv.y - 0.35 - wave) * 9.0;\n  float secondDistance = (uv.y - 0.72 + wave * 0.7) * 12.0;\n  float ribbon = exp(-ribbonDistance * ribbonDistance);\n  float second = exp(-secondDistance * secondDistance);\n  vec2 lightPosition = vec2(0.68 + 0.12 * sin(t * 0.13), 0.18);\n  float bloom = exp(-dot(uv - lightPosition, uv - lightPosition) * 8.0);\n  float motif = ribbon * 0.60 + second * 0.38 + bloom * 0.24;`+FOOTER},documentary:{name:\"Documentary / Contour atlas\",source:HEADER+`  float terrain = p.y + sin(p.x * 0.8 + t * 0.035) * 0.17\n    + sin(p.x * 1.9 - t * 0.025) * 0.045;\n  float contours = abs(fract(terrain * 7.0 + 0.5) - 0.5) / 7.0;\n  float lines = 1.0 - smoothstep(aa * 0.65, aa * 1.5, contours);\n  float motif = lines * 0.42 + (0.5 + 0.5 * sin(p.x * 0.45)) * 0.10;`+FOOTER}};var ImportType=function(A){return A[A.Static=1]=\"Static\",A[A.Dynamic=2]=\"Dynamic\",A[A.ImportMeta=3]=\"ImportMeta\",A[A.StaticSourcePhase=4]=\"StaticSourcePhase\",A[A.DynamicSourcePhase=5]=\"DynamicSourcePhase\",A[A.StaticDeferPhase=6]=\"StaticDeferPhase\",A[A.DynamicDeferPhase=7]=\"DynamicDeferPhase\",A}({}),A=new Uint8Array(new Uint16Array([1]).buffer)[0]===1;var 